# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# is what every script actually reads (see scripts/load-env.cjs) — this file
# is a template only. Never put real credentials in .env.example.
#
# This project connects to Aiven MySQL only (dev and prod both use Aiven —
# use a different DATABASE_NAME per environment inside the same Aiven
# service, or a different DATABASE_URL entirely for full isolation).

DATABASE_URL=mysql://USERNAME:PASSWORD@YOUR-SERVICE.aivencloud.com:PORT/DATABASE_NAME?ssl-mode=VERIFY_CA
# CA certificate (download from the Aiven console: your service > Overview >
# "CA Certificate"). Required when ssl-mode is VERIFY_CA or VERIFY_IDENTITY.
# Use DATABASE_SSL_CA_PATH for local dev (path to a file — certs/ is
# git-ignored). On Vercel or any other host where you can't commit/mount a
# file, set DATABASE_SSL_CA instead, pasting the certificate's full contents
# directly as the env var value — DATABASE_SSL_CA takes priority if both are set.
DATABASE_SSL_CA_PATH=./certs/aiven-ca.pem
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_CONNECTION_LIMIT=5
AUTH_SECRET=change-me-to-a-random-secret

# --- Cloudinary (product images + shop logos) -------------------------------
# From your Cloudinary dashboard: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
